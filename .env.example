# ==========================================
# BACKEND (Node.js + Express + Gemini API)
# ==========================================
# GEMINI_API_KEY: Clave de Gemini API (solo en backend, nunca en frontend).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL de la aplicación (inyectada automáticamente en producción/AI Studio).
APP_URL="MY_APP_URL"

# CORS_ORIGINS: Lista separada por comas de orígenes permitidos en producción (ej. URL del frontend en Render).
CORS_ORIGINS=""

# ==========================================
# FRONTEND & SUPABASE (Acceso público solo lectura)
# ==========================================
# URL del proyecto Supabase (ej. https://tu-proyecto.supabase.co)
VITE_SUPABASE_URL=
# Clave pública anon de Supabase (NUNCA usar service_role aquí)
VITE_SUPABASE_ANON_KEY=
